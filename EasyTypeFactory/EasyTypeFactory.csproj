<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;netstandard2.1</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Title>EasyTypeFactory</Title>
        <Authors>banator99</Authors>
        <Description>EasyTypeFactory helps you with creating types fluently in .NET.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/banator99/EasyTypeFactory</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/banator99/EasyTypeFactory</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\icon.png"
              Pack="true"
              PackagePath="icon.png" />
        <None Include="..\README.md"
              Pack="true"
              PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="EasyTypeFactory.UnitTests" />
        <InternalsVisibleTo Include="EasyTypeFactory.IntegrationTests" />
        <InternalsVisibleTo Include="EasyTypeFactory.HyperbeeExpressionCompiler.UnitTests" />
        <InternalsVisibleTo Include="EasyTypeFactory.HyperbeeExpressionCompiler.IntegrationTests" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
      <PackageReference Include="System.Collections.Immutable" Version="11.0.0" />
    </ItemGroup>

</Project>
