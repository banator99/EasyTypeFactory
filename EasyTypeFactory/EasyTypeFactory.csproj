<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Title>EasyTypeFactory</Title>
        <Authors>banator99</Authors>
        <Description>EasyTypeFactory helps you with creating types fluently in .NET.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/banator99/EasyTypeFactory</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/banator99/EasyTypeFactory</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="EasyTypeFactory.UnitTests" />
        <InternalsVisibleTo Include="EasyTypeFactory.IntegrationTests" />
        <InternalsVisibleTo Include="EasyTypeFactory.HyperbeeExpressionCompiler.UnitTests" />
        <InternalsVisibleTo Include="EasyTypeFactory.HyperbeeExpressionCompiler.IntegrationTests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="System.Collections.Immutable" Version="10.0.13" />
    </ItemGroup>

</Project>
