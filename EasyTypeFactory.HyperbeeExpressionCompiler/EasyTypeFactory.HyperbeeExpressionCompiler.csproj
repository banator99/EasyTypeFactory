<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Title>EasyTypeFactory.HyperbeeExpressionCompiler</Title>
        <Authors>banator99</Authors>
        <Description>EasyTypeFactory helps you with creating types fluently in .NET.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/banator99/EasyTypeFactory</PackageProjectUrl>
        <RepositoryUrl>https://github.com/banator99/EasyTypeFactory</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\icon.png"
              Pack="true"
              PackagePath="icon.png" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\EasyTypeFactory\EasyTypeFactory.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="EasyTypeFactory.HyperbeeExpressionCompiler.UnitTests" />
        <InternalsVisibleTo Include="EasyTypeFactory.HyperbeeExpressionCompiler.IntegrationTests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Hyperbee.Expressions.Compiler" Version="1.5.1" />
    </ItemGroup>

</Project>
